    "## 1. Kubernetes 核心概念 —— Pod / Service / Deployment / Ingress\n",
    "\n",
    "**Pod**：\n",
    "- k8s 的最小部署单元（一个或多个容器）\n",
    "- 每个 Pod 有唯一 IP（集群内部）\n",
    "- 不持久化（Pod 被 k8s 删除后重建，IP 会变）\n",
    "\n",
    "**Service**：\n",
    "- 暴露 Pod 集合（无状态服务）\n",
    "- 提供**稳定的** ClusterIP / NodePort / LoadBalancer IP\n",
    "- 支持基于 label 选择器的自动发现\n",
    "\n",
    "**Deployment**：\n",
    "- 管理 Pod 的生命周期（副本数、滚动更新、回滚）\n",
    "- 自动处理 Pod 意外终止（重建）\n",
    "- 支持版本控制和灰度发布\n",
    "\n",
    "**Ingress**：\n",
    "- 管理 HTTP(S) 流量（外部到 Service 的入口）\n",
    "- 支持域名路由、TLS 终结、负载均衡\n",
    "- 通常用 Nginx Ingress Controller 实现"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s1-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# k8s Deployment YAML 示例\n",
    "deployment_yaml = '''\n",
    "apiVersion: apps/v1\n",
    "kind: Deployment\n",
    "metadata:\n",
    "  name: rag-app\n",
    "  namespace: production\n",
    "spec:\n",
    "  replicas: 3  # 3 个副本\n",
    "  selector:\n",
    "    matchLabels:\n",
    "      app: rag\n",
    "  template:\n",
    "    metadata:\n",
    "      labels:\n",
    "        app: rag\n",
    "        version: v1.0.0\n",
    "    spec:\n",
    "      containers:\n",
    "      - name: rag-api\n",
    "        image: registry.example.com/rag-app:v1.0.0\n",
    "        ports:\n",
    "        - containerPort: 8000\n",
    "        resources:\n",
    "          requests:\n",
    "            cpu: \"500m\"  # 0.5 CPU\n",
    "            memory: \"512Mi\"\n",
    "          limits:\n",
    "            cpu: \"1000m\"  # 1 CPU\n",
    "            memory: \"1Gi\"\n",
    "        env:\n",
    "        - name: CHROMA_HOST\n",
    "          value: \"chroma-service\"\n",
    "        - name: VLLM_HOST\n",
    "          value: \"vllm-service\"\n",
    "'''\n",
    "\n",
    "# k8s Service YAML 示例\n",
    "service_yaml = '''\n",
    "apiVersion: v1\n",
    "kind: Service\n",
    "metadata:\n",
    "  name: rag-service\n",
    "  namespace: production\n",
    "spec:\n",
    "  selector:\n",
    "    app: rag\n",
    "  ports:\n",
    "  - port: 80\n",
    "    targetPort: 8000\n",
    "    protocol: TCP\n",
    "  type: ClusterIP  # 集群内部访问\n",
    "'''\n",
    "\n",
    "# k8s Ingress YAML 示例\n",
    "ingress_yaml = '''\n",
    "apiVersion: networking.k8s.io/v1\n",
    "kind: Ingress\n",
    "metadata:\n",
    "  name: rag-ingress\n",
    "  namespace: production\n",
    "  annotations:\n",
    "    cert-manager.io/cluster-issuer: letsencrypt-prod\n",
    "spec:\n",
    "  ingressClassName: nginx\n",
    "  tls:\n",
    "  - hosts:\n",
    "    - api.example.com\n",
    "    secretName: rag-tls\n",
    "  rules:\n",
    "  - host: api.example.com\n",
    "    http:\n",
    "      paths:\n",
    "      - path: /\n",
    "        pathType: Prefix\n",
    "        backend:\n",
    "          service:\n",
    "            name: rag-service\n",
    "            port:\n",
    "              number: 80\n",
    "'''\n",
    "\n",
    "# 写入 YAML 文件\n",
    "Path('k8s_deployment.yaml').write_text(deployment_yaml)\n",
    "Path('k8s_service.yaml').write_text(service_yaml)\n",
    "Path('k8s_ingress.yaml').write_text(ingress_yaml)\n",
    "\n",
    "print('✅ k8s YAML 文件已生成：')\n",
    "print('  - k8s_deployment.yaml (Deployment)')\n",
    "print('  - k8s_service.yaml (Service)')\n",
    "print('  - k8s_ingress.yaml (Ingress)')"
   ]
