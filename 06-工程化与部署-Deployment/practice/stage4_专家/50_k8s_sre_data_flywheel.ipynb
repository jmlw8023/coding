   "cell_type": "code",
   "execution_count": null,
   "id": "s4-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 数据飞轮闭环模拟\n",
    "class DataFlywheelSim:\n",
    "    def __init__(self):\n",
    "        self.feedback_collected = 0\n",
    "        self.feedback_useful = 0\n",
    "        self.feedback_useless = 0\n",
    "        self.baseline_metrics = {\n",
    "            'ctx_relevance': 0.45,\n",
    "            'context_precision': 0.62,\n",
    "            'faithfulness': 0.83,\n",
    "            'answer_relevance': 0.45\n",
    "        }\n",
    "        self.optimized_metrics = self.baseline_metrics.copy()\n",
    "    \n",
    "    def collect_feedback(self, is_useful: bool):\n",
    "        self.feedback_collected += 1\n",
    "        if is_useful:\n",
    "            self.feedback_useful += 1\n",
    "            # 有用反馈：触发优化\n",
    "            self.trigger_optimization()\n",
    "        else:\n",
    "            self.feedback_useless += 1\n",
    "    \n",
    "    def trigger_optimization(self):\n",
    "        # 简单的优化策略：提升 context_relevance（假设知道是检索问题）\n",
    "        improvement = 0.05\n",
    "        for key in self.optimized_metrics:\n",
    "            if key == 'ctx_relevance':\n",
    "                self.optimized_metrics[key] += improvement\n",
    "        print(f'✅ Optimization applied: ctx_relevance ↑ by {improvement}')\n",
    "    \n",
    "    def feedback_rate(self):\n",
    "        return self.feedback_collected / 100  # 假设 100 个用户\n",
    "    \n",
    "    def useful_rate(self):\n",
    "        return self.feedback_useful / self.feedback_collected if self.feedback_collected > 0 else 0\n",
    "    \n",
    "    def show_state(self):\n",
    "        print(f'\\n📊 Data Flywheel State:')\n",
    "        print(f'  Feedback collected: {self.feedback_collected}')\n",
    "        print(f'  Feedback useful: {self.feedback_useful}')\n",
    "        print(f'  Feedback useless: {self.feedback_useless}')\n",
    "        print(f'  Feedback rate: {self.feedback_rate():.2%}')\n",
    "        print(f'  Useful rate: {self.useful_rate():.2%}')\n",
    "        print(f'  Baseline metrics: {self.baseline_metrics}')\n",
    "        print(f'  Optimized metrics: {self.optimized_metrics}')\n",
    "        print(f'  Improvement: {self._compute_improvement()}')\n",
    "\n",
    "    def _compute_improvement(self):\n",
    "        delta = {}\n",
    "        for key in self.optimized_metrics:\n",
    "            delta[key] = self.optimized_metrics[key] - self.baseline_metrics[key]\n",
    "        return delta\n",
    "\n",
    "# 模拟 100 个用户反馈\n",
    "flywheel = DataFlywheelSim()\n",
    "\n",
    "print('Simulating 100 user feedbacks:')\n",
    "for i in range(100):\n",
    "    is_useful = random.random() < 0.4  # 40% 用户觉得有用\n",
    "    flywheel.collect_feedback(is_useful)\n",
    "\n",
    "flywheel.show_state()"
   ]
  },
