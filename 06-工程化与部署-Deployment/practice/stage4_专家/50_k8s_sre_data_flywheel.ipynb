    "# eval_baseline.py 脚本示例\n",
    "eval_baseline_script = '''\n",
    "# eval_baseline.py\n",
    "import sys\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "\n",
    "def evaluate_current_config():\n",
    "    \"\"\"运行 eval 并生成 baseline 条目\"\"\"\n",
    "    # 1. 加载 eval set\n",
    "    eval_set = load_eval_set()\n",
    "    \n",
    "    # 2. 运行 RAG eval\n",
    "    current_result = run_rag_eval(eval_set)\n",
    "    \n",
    "    # 3. 加载上次 baseline\n",
    "    baseline = load_baseline()\n",
    "    \n",
    "    # 4. 计算差异\n",
    "    delta = compute_delta(baseline, current_result)\n",
    "    \n",
    "    # 5. 生成 baseline.md 条目\n",
    "    today = datetime.now().isoformat()\n",
    "    entry = generate_baseline_entry(today, current_result, delta)\n",
    "    \n",
    "    # 6. 写入 baseline.md\n",
    "    append_baseline(entry)\n",
    "    \n",
    "    print(f'✅ Eval complete: {entry}')\n",
    "\n",
    "def load_eval_set():\n",
    "    \"\"\"加载 eval set\"\"\"\n",
    "    # 从 eval/v1_30q.jsonl 加载\n",
    "    return []\n",
    "\n",
    "def run_rag_eval(eval_set):\n",
    "    \"\"\"运行 RAG eval\"\"\"\n",
    "    # 调用 RAGSystem.query()\n",
    "    return {}  # 返回 metrics\n",
    "\n",
    "def load_baseline():\n",
    "    \"\"\"加载上次 baseline\"\"\"\n",
    "    baseline_path = Path('baseline.md')\n",
    "    if not baseline_path.exists():\n",
    "        return None\n",
    "    # 解析 baseline.md\n",
    "    return {}\n",
    "\n",
    "def compute_delta(baseline, current):\n",
    "    \"\"\"计算差异\"\"\"\n",
    "    delta = {}\n",
    "    for key in current:\n",
    "        if baseline and key in baseline:\n",
    "            delta[key] = current[key] - baseline[key]\n",
    "        else:\n",
    "            delta[key] = current[key]\n",
    "    return delta\n",
    "\n",
    "def generate_baseline_entry(date, current, delta):\n",
    "    \"\"\"生成 baseline 条目\"\"\"\n",
    "    entry = f'| {date} | current_config | ctx_rel={current[\"context_relevance\"]:.3f} | ... |\n",
    "    return entry\n",
    "\n",
    "def append_baseline(entry):\n",
    "    \"\"\"追加到 baseline.md\"\"\"\n",
    "    baseline_path = Path('baseline.md')\n",
    "    with open(baseline_path, 'a') as f:\n",
    "        f.write(entry + '\\n')\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    evaluate_current_config()\n',
    "\n",
    "Path('eval_baseline.py').write_text(eval_baseline_script)\n",
    "print('✅ eval_baseline.py 脚本已生成')"
   ]
