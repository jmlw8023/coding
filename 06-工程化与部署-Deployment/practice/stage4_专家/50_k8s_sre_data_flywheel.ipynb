   "source": [
    "# 50 · k8s 部署 + CI/CD + SLO + 数据飞轮\n",
    "\n",
    "> **学习目标**：理解 Kubernetes 核心概念（Pod / Service / Deployment / Ingress）；掌握 CI/CD 流水线（GitHub Actions / GitLab CI）；学会定义 SLO（服务等级目标）和监控体系；理解「数据飞轮」闭环机制。\n",
    "\n",
    "> **预备**：16–24 跑过，48 跑过，49 跑过。**前置条件**：理解 Docker + Docker Compose。\n",
    "\n",
    "> **为什么重要**：**k8s 是生产级 RAG 的标准基础设施**（容器编排、滚动更新、自动扩缩容、故障自愈）。**CI/CD 是 RAG 优化的前提**（每次改动必须自动 eval + baseline）。**SLO 是 RAG 优化的北极星指标**（必须基于数据做决策，而不是凭感觉）。**数据飞轮是 RAG 性能的终极保障**（用户反馈自动回流到检索和生成）。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "setup",
   "metadata": {},
   "outputs": [],
   "source": [
    "MODE = 'OFFLINE'\n",
    "\n",
    "import json, yaml, time, hashlib, re, math, random\n",
    "from dataclasses import dataclass, field\n",
    "from typing import Dict, List, Optional\n",
    "from datetime import datetime, timedelta\n",
    "from pathlib import Path\n",
    "from collections import defaultdict, deque\n",
    "\n",
    "# 模拟 k8s Deployment 的滚动更新\n",
    "class RollingUpdateSim:\n",
    "    def __init__(self, desired_replicas: int = 3):\n",
    "        self.desired_replicas = desired_replicas\n",
    "        self.current_replicas = 0\n",
    "        self.version = 'v1'\n",
    "        self.history = []\n",
    "    \n",
    "    def start_upgrade(self, new_version: str):\n",
    "        \"\"\"开始滚动更新：逐步增加新版本副本\"\"\"\n",
    "        print(f'\\n🚀 Starting rolling update: {self.version} → {new_version}')\n",
    "        self.history.append({'timestamp': datetime.now().isoformat(), 'action': 'start_upgrade', 'from': self.version, 'to': new_version})\n",
    "        \n",
    "        # 模拟逐步扩容\n",
    "        for i in range(1, self.desired_replicas + 1):\n",
    "            self.current_replicas = i\n",
    "            self.version = new_version\n",
    "            self.history.append({'timestamp': datetime.now().isoformat(), 'action': 'scale_up', 'replicas': i, 'version': new_version})\n",
    "            time.sleep(0.5)  # 模拟扩容延迟\n",
    "            print(f'  Replicas: {i}/{self.desired_replicas}, version: {new_version}')\n",
    "        \n",
    "        print(f'\\n✅ Rolling update complete: {self.desired_replicas} replicas running {new_version}')\n",
    "\n",
    "# 模拟 CI/CD 流水线\n",
    "class CICDPipelineSim:\n",
    "    def __init__(self):\n",
    "        self.jobs = []\n",
    "        self.failed_runs = 0\n",
    "    \n",
    "    def run(self, commit_hash: str, branch: str):\n",
    "        print(f'\\n🔄 CI Pipeline started: {branch} @ {commit_hash[:8]}')\n",
    "        self.jobs = []\n",
    "        \n",
    "        # Job 1: Lint / Test\n",
    "        self.jobs.append(self._run_job('lint_test', duration=random.randint(1, 3)))\n",
    "        # Job 2: Build Docker\n",
    "        self.jobs.append(self._run_job('build', duration=random.randint(2, 4)))\n",
    "        # Job 3: Run eval\n",
    "        self.jobs.append(self._run_job('eval', duration=random.randint(5, 10)))\n",
    "        # Job 4: Deploy (only on main branch)\n",
    "        if branch == 'main':\n",
    "            self.jobs.append(self._run_job('deploy', duration=random.randint(3, 5)))\n",
    "        \n",
    "        # Check results\n",
    "        failed = [j for j in self.jobs if not j['success']]\n",
    "        if failed:\n",
    "            self.failed_runs += 1\n",
    "            print(f'❌ CI failed: {len(failed)} jobs failed')\n",
    "            return False\n",
    "        else:\n",
    "            print(f'✅ CI success: {len(self.jobs)} jobs passed')\n",
    "            return True\n",
    "    \n",
    "    def _run_job(self, name: str, duration: int) -> dict:\n",
    "        print(f'  Running {name}...')\n",
    "        time.sleep(duration)\n",
    "        success = random.random() > 0.1  # 90% 成功率\n",
    "        if not success:\n",
    "            print(f'    ❌ {name} failed')\n",
    "        else:\n",
    "            print(f'    ✅ {name} passed')\n",
    "        return {'name': name, 'success': success, 'duration': duration}\n",
    "\n",
    "# 模拟 SLO 监控\n",
    "class SLOMonitorSim:\n",
    "    def __init__(self, slo_dict: Dict[str, float]):\n",
    "        self.slo_dict = slo_dict  # {'p95_latency_ms': 500, 'accuracy': 0.9, ...}\n",
    "        self.metrics = defaultdict(list)\n",
    "    \n",
    "    def record_metric(self, metric_name: str, value: float):\n",
    "        self.metrics[metric_name].append(value)\n",
    "        self._check_slo(metric_name, value)\n",
    "    \n",
    "    def _check_slo(self, metric_name: str, value: float):\n",
    "        slo = self.slo_dict.get(metric_name)\n",
    "        if slo:\n",
    "            violated = False\n",
    "            if metric_name.endswith('_p95'):\n",
    "                # P95 超过阈值算违反\n",
    "                if value > slo:\n",
    "                    violated = True\n",
    "            elif metric_name == 'accuracy':\n",
    "                if value < slo:\n",
    "                    violated = True\n",
    "            \n",
    "            if violated:\n",
    "                print(f'⚠️  SLO VIOLATION: {metric_name} = {value:.2f} (target: {slo})')\n",
    "    \n",
    "    def get_p95(self, metric_name: str) -> float:\n",
    "        values = self.metrics[metric_name]\n",
    "        if not values:\n",
    "            return 0.0\n",
    "        return sorted(values)[int(len(values) * 0.95)]\n",
    "\n",
    "print('✅ k8s / CI/CD / SLO 模拟器加载完毕')"
   ]
  },
