    "# SLO 监控实现\n",
    "def simulate_slo_monitoring():\n",
    "    # 定义 SLO\n",
    "    slo = {\n",
    "        'p95_latency_ms': 500,\n",
    "        'p99_latency_ms': 2000,\n",
    "        'accuracy': 0.90\n",
    "    }\n",
    "    \n",
    "    monitor = SLOMonitorSim(slo)\n",
    "    \n",
    "    # 模拟一段时间内的指标\n",
    "    num_samples = 100\n",
    "    for i in range(num_samples):\n",
    "        # 生成模拟指标\n",
    "        latency = random.gauss(300, 200)  # 正态分布\n",
    "        accuracy = random.random() * 0.2 + 0.85  # 0.85-1.05\n",
    "        \n",
    "        # 记录 P95\n",
    "        monitor.record_metric('p95_latency_ms', latency)\n",
    "        # 记录 P99\n",
    "        monitor.record_metric('p99_latency_ms', latency * 1.5)\n",
    "        # 记录 accuracy\n",
    "        monitor.record_metric('accuracy', accuracy)\n",
    "    \n",
    "    # 输出 SLO 状态\n",
    "    print('\\nSLO 状态：')\n",
    "    for metric in slo:\n",
    "        p95 = monitor.get_p95(f'{metric}_p95_ms') if metric == 'p95_latency_ms' else monitor.get_p95(f'{metric}_p99_ms')\n",
    "        if metric == 'accuracy':\n",
    "            status = '✅ PASS' if p95 >= slo[metric] else '⚠️ VIOLATION'\n",
    "            print(f'{metric:<20}: {p95:.2f} (target: {slo[metric]}) [{status}]')\n",
    "        else:\n",
    "            status = '✅ PASS' if p95 <= slo[metric] else '⚠️ VIOLATION'\n",
    "            print(f'{metric:<20}: {p95:.2f} (target: {slo[metric]}) [{status}]')\n",
    "\n",
    "print(simulate_slo_monitoring())"
   ]
  },
