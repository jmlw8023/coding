    "## 4. 熔断器模式 —— 应对 LLM API 故障\n",
    "\n",
    "**熔断器状态机**：\n",
    "- **关闭（Closed）**：正常状态，请求直接转发到 LLM API\n",
    "- **打开（Open）**：失败率超过阈值（比如 50%），熔断器打开，直接返回错误（不调用 LLM）\n",
    "- **半开（Half-Open）**：熔断器等待一段时间后进入半开状态，尝试放一个请求。如果成功 → 关闭；失败 → 再次打开\n",
    "\n",
    "**为什么需要熔断器**：\n",
    "- LLM API 可能因为网络波动、服务器过载、限流而失败\n",
    "- 单点故障会打满整个系统（所有请求都卡在 LLM 调用）\n",
    "- 熔断器可以快速失败，让上层服务降级（返回缓存答案、限流等）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s4-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 熔断器实现\n",
    "class CircuitBreaker:\n",
    "    STATES = ['CLOSED', 'OPEN', 'HALF_OPEN']\n",
    "    \n",
    "    def __init__(self, failure_threshold=5, timeout=60):\n",
    "        self.failure_threshold = failure_threshold  # 失败阈值\n",
    "        self.timeout = timeout  # 打开后多久进入半开状态（秒）\n",
    "        self.state = 'CLOSED'\n",
    "        self.failure_count = 0\n",
    "        self.last_failure_time = None\n",
    "        self.next_attempt_time = None\n",
    "    \n",
    "    def call(self, func, *args, **kwargs):\n",
    "        '''执行函数，自动处理熔断器状态'''\n",
    "        if self.state == 'OPEN':\n",
    "            # 检查是否进入半开状态\n",
    "            if self.next_attempt_time and time.time() >= self.next_attempt_time:\n",
    "                self.state = 'HALF_OPEN'\n",
    "                self.failure_count = 0\n",
    "                print('Circuit breaker: HALF_OPEN state')\n",
    "            else:\n",
    "                raise Exception(f'Circuit breaker is OPEN, next attempt at {self.next_attempt_time}')\n",
    "        \n",
    "        try:\n",
    "            result = func(*args, **kwargs)\n",
    "            self.on_success()\n",
    "            return result\n",
    "        except Exception as e:\n",
    "            self.on_failure()\n",
    "            raise e\n",
    "    \n",
    "    def on_success(self):\n",
    "        if self.state == 'HALF_OPEN':\n",
    "            self.state = 'CLOSED'\n",
    "            self.failure_count = 0\n",
    "            print('Circuit breaker: CLOSED state (recovered)')\n",
    "        elif self.state == 'CLOSED':\n",
    "            self.failure_count = 0\n",
    "    \n",
    "    def on_failure(self):\n",
    "        self.failure_count += 1\n",
    "        self.last_failure_time = time.time()\n",
    "        \n",
    "        if self.failure_count >= self.failure_threshold:\n",
    "            self.state = 'OPEN'\n",
    "            self.next_attempt_time = time.time() + self.timeout\n",
    "            print(f'Circuit breaker: OPEN state (failure_count={self.failure_count})')\n",
    "\n",
    "# 测试熔断器\n",
    "def test_circuit_breaker():\n",
    "    cb = CircuitBreaker(failure_threshold=3, timeout=2)\n",
    "    \n",
    "    def mock_llm_call(success: bool):\n",
    "        if success:\n",
    "            return 'success'\n",
    "        else:\n",
    "            raise Exception('LLM API error')\n",
    "    \n",
    "    # 模拟请求序列\n",
    "    for i in range(7):\n",
    "        try:\n",
    "            result = cb.call(mock_llm_call, success=(i < 3))\n",
    "            print(f'Request {i+1}: {result}')\n",
    "        except Exception as e:\n",
    "            print(f'Request {i+1}: Circuit breaker triggered: {e}')\n",
    "\n",
    "print(test_circuit_breaker())"
   ]
  },
