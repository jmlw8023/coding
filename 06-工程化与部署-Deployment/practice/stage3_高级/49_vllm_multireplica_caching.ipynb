   "source": [
    "# 比较传统 KV Cache 和 PagedAttention\n",
    "print('传统 KV Cache vs PagedAttention：\n',\n",
    "      '- 传统：每个请求单独申请固定大小 KV cache（比如 4096 tokens）'\n",
    "      '- PagedAttention：按实际需求分配 block（16 tokens/block）\n',\n",
    "      '- 优势：显存利用率高，避免浪费；支持更高并发；降低 OOM 风险')\n",
    "\n",
    "# 模拟请求模式\n",
    "class RequestPattern:\n",
    "    def __init__(self, pattern_type):\n",
    "        self.pattern_type = pattern_type\n",
    "        \n",
    "    def generate_requests(self, count):\n",
    "        if self.pattern_type == 'long_tailed':\n",
    "            # 长尾：10% 长请求（>512），90% 短请求（<64）\n",
    "            return [random.choice([512, 768, 1024, 1280, 1536]) if random.random() < 0.1 else random.randint(16, 64) for _ in range(count)]\n",
    "        elif self.pattern_type == 'burst':\n",
    "            # 突发：前 20 个请求很长，后面变短\n",
    "            return [random.randint(512, 1536) if i < 20 else random.randint(16, 64) for i in range(count)]\n",
    "        elif self.pattern_type == 'uniform':\n",
    "            return [random.randint(64, 128) for _ in range(count)]\n",
    "\n",
    "# 对比不同请求模式\n",
    "patterns = ['long_tailed', 'burst', 'uniform']\n",
    "for pattern_type in patterns:\n",
    "    pat = PagedAttentionSim(NUM_BLOCKS=100, BLOCK_SIZE=16)\n",
    "    reqs = RequestPattern(pattern_type).generate_requests(50)\n",
    "    for tokens in reqs:\n",
    "        pat.allocate(tokens)\n",
    "    print(f'{pattern_type:10s}: {pat.memory_usage():4d} / {100*16} = {pat.memory_usage()/(100*16):.2%}')"
   ]
