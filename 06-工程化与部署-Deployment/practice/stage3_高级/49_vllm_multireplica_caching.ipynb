   "source": [
    "# 49 · vLLM / Prefix Cache / 多副本 / 缓存 + 熔断\n",
    "\n",
    "> **学习目标**：理解 vLLM 的 PagedAttention、Prefix Cache / Continuous Batching；掌握多副本部署模式；学会用熔断器模式应对 LLM API 故障。\n",
    "\n",
    "> **预备**：16–24 跑过，48 跑过。**前置条件**：了解基本的 LLM serving（vLLM / Ollama）。\n",
    "\n",
    "> **为什么重要**：**LLM serving 性能瓶颈**：- 吞吐量受限于 GPU 并发度\n",
    "- 相同 prompt 重复计算浪费显存\n",
    "- 单点故障会导致整个服务不可用\n",
    "- 长尾请求（超长 prompt）会打满队列\n",
    "vLLM 的核心优势就是解决这些问题。**熔断器是生产级 RAG 的必备安全网**。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "setup",
   "metadata": {},
   "outputs": [],
   "source": [
    "MODE = 'OFFLINE'\n",
    "\n",
    "import json, time, hashlib, re, math, asyncio\n",
    "from dataclasses import dataclass\n",
    "from typing import Optional, Callable\n",
    "from datetime import datetime\n",
    "from collections import defaultdict, deque\n",
    "import random\n",
    "\n",
    "# 模拟 vLLM 的 PagedAttention（简化版）\n",
    "class PagedAttentionSim:\n",
    "    \"\"\"模拟 GPU 内存按 block 管理（PagedAttention 的核心思想）\"\"\"\n",
    "    BLOCK_SIZE = 16  # 每个 block 16 tokens\n",
    "    NUM_BLOCKS = 100\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.free_blocks = set(range(self.NUM_BLOCKS))\n",
    "        self.used_blocks = {}  # token_idx -> block_id\n",
    "        self.block_allocations = defaultdict(list)  # block_id -> [token_idx, ...]\n",
    "    \n",
    "    def allocate(self, num_tokens: int) -> list[int]:\n",
    "        \"\"\"分配连续的 block，返回 block_id 列表\"\"\"\n",
    "        blocks_needed = math.ceil(num_tokens / self.BLOCK_SIZE)\n",
    "        allocated = []\n",
    "        for _ in range(blocks_needed):\n",
    "            if not self.free_blocks:\n",
    "                raise MemoryError('No free blocks')\n",
    "            block_id = self.free_blocks.pop()\n",
    "            allocated.append(block_id)\n",
    "        return allocated\n",
    "    \n",
    "    def free(self, block_ids: list[int]):\n",
    "        \"\"\"释放 block\"\"\"\n",
    "        for block_id in block_ids:\n",
    "            self.free_blocks.add(block_id)\n",
    "    \n",
    "    def memory_usage(self):\n",
    "        return len(self.used_blocks) * self.BLOCK_SIZE\n",
    "\n",
    "# 模拟连续批处理（Continuous Batching）\n",
    "class ContinuousBatchSim:\n",
    "    \"\"\"模拟 Continuous Batching：多个 partial request 共享 GPU\"\"\"\n",
    "    MAX_CONTEXT_LEN = 4096\n",
    "    \n",
    "    def __init__(self, num_gpus: int = 1):\n",
    "        self.gpus = [PagedAttentionSim() for _ in range(num_gpus)]\n",
    "        self.requests = {}  # request_id -> {prompt, prompt_tokens, output_tokens, status}\n",
    "        self.request_id_counter = 0\n",
    "    \n",
    "    def add_request(self, prompt: str) -> int:\n",
    "        \"\"\"添加请求，返回 request_id\"\"\"\n",
    "        prompt_tokens = len(prompt.split())\n",
    "        self.request_id_counter += 1\n",
    "        req_id = self.request_id_counter\n",
    "        self.requests[req_id] = {\n",
    "            'prompt': prompt,\n",
    "            'prompt_tokens': prompt_tokens,\n",
    "            'output_tokens': 0,\n",
    "            'status': 'pending'  # pending / processing / done\n",
    "        }\n",
    "        return req_id\n",
    "    \n",
    "    def step(self):\n",
    "        \"\"\"模拟一步推理（采样下一个 token）\"\"\"\n",
    "        completed = []\n",
    "        for req_id, req in list(self.requests.items()):\n",
    "            if req['status'] == 'done':\n",
    "                completed.append(req_id)\n",
    "                continue\n",
    "            \n",
    "            if req['status'] == 'pending':\n",
    "                # 尝试分配 GPU\n",
    "                if len(self.gpus) > 0:\n",
    "                    try:\n",
    "                    gpu = self.gpus[0]\n",
    "                    blocks = gpu.allocate(req['prompt_tokens'])\n",
    "                    req['status'] = 'processing'\n",
    "                    req['gpu_blocks'] = blocks\n",
    "                    # 模拟 token 生成\n",
    "                    tokens_generated = random.randint(1, 5)\n",
    "                    req['output_tokens'] += tokens_generated\n",
    "                    # 检查是否完成\n",
    "                    if req['prompt_tokens'] + req['output_tokens'] >= self.MAX_CONTEXT_LEN:\n",
    "                        req['status'] = 'done'\n",
    "                        gpu.free(blocks)\n",
    "                    except MemoryError:\n",
    "                        pass  # 跳过（等待其他请求释放）\n",
    "            \n",
    "            elif req['status'] == 'processing':\n",
    "                # 继续生成\n",
    "                tokens_generated = random.randint(1, 5)\n",
    "                req['output_tokens'] += tokens_generated\n",
    "                if req['prompt_tokens'] + req['output_tokens'] >= self.MAX_CONTEXT_LEN:\n",
    "                    req['status'] = 'done'\n",
    "                    req['gpu_blocks'][-1].free(req['gpu_blocks'])\n",
    "        \n",
    "        # 清理完成的请求\n",
    "        for req_id in completed:\n",
    "            del self.requests[req_id]\n",
    "    \n",
    "    def stats(self):\n",
    "        total_pending = sum(1 for r in self.requests.values() if r['status'] == 'pending')\n",
    "        total_processing = sum(1 for r in self.requests.values() if r['status'] == 'processing')\n",
    "        return {\n",
    "            'pending': total_pending,\n",
    "            'processing': total_processing,\n",
    "            'completed': self.request_id_counter - total_pending - total_processing,\n",
    "            'gpu_memory': sum(g.memory_usage() for g in self.gpus)\n",
    "        }\n",
    "\n",
    "print('✅ vLLM 模拟器加载完毕；PagedAttention / Continuous Batching 已模拟')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s1-md",
