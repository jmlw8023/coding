    "# 多副本部署配置示例\n",
    "multi_replica_config = '''\n",
    "# docker-compose.yml（多副本 RAG 服务）\n",
    "version: '3.8'\n",
    "\n",
    "services:\n",
    "  rag-api:\n",
    "    build: ./rag-api\n",
    "    deploy:\n",
    "      replicas: 3  # 3 个副本\n",
    "    environment:\n",
    "      - CHROMA_HOST=chroma\n",
    "      - VLLM_HOST=vllm:8000\n",
    "    depends_on:\n",
    "      - chroma\n",
    "      - vllm\n",
    "    restart: unless-stopped\n",
    "\n",
    "  nginx:\n",
    "    image: nginx:alpine\n",
    "    ports:\n",
    "      - \"80:80\"\n",
    "    volumes:\n",
    "      - ./nginx.conf:/etc/nginx/nginx.conf:ro\n",
    "    depends_on:\n",
    "      - rag-api\n",
    "    restart: unless-stopped\n",
    "\n",
    "  chroma:\n",
    "    image: chromadb/chroma:latest\n",
    "    ports:\n",
    "      - \"8001:8000\"\n",
    "    volumes:\n",
    "      - ./chroma-data:/chroma/chroma\n",
    "    restart: unless-stopped\n',
    "\n",
    "# nginx.conf 示例\n",
    "nginx_config = '''\n",
    "events {\n",
    "    worker_connections 1024;\n",
    "}\n",
    "\n",
    "http {\n",
    "    upstream rag_api {\n",
    "        least_conn;  # 最少连接数算法\n",
    "        server rag-api-1:8000;\n",
    "        server rag-api-2:8000;\n",
    "        server rag-api-3:8000;\n",
    "    }\n",
    "\n",
    "    server {\n",
    "        listen 80;\n",
    "        location / {\n",
    "            proxy_pass http://rag_api;\n",
    "            proxy_http_version 1.1;\n",
    "            proxy_set_header Upgrade $http_upgrade;\n",
    "            proxy_set_header Connection \"upgrade\";\n",
    "            proxy_set_header Host $host;\n",
    "        }\n",
    "    }\n",
    "}\n',
    "\n",
    "Path('docker-compose-multi-replica.yml').write_text(multi_replica_config)\n",
    "Path('nginx.conf').write_text(nginx_config)\n",
    "print('✅ 多副本部署配置文件已生成')"
   ]
