   "source": [
    "# 模拟 Continuous Batching 的工作流程\n",
    "async def simulate_continuous_batching():\n",
    "    cb = ContinuousBatchSim(num_gpus=1)\n",
    "    \n",
    "    # 添加一批请求\n",
    "    prompts = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']\n",
    "    for p in prompts:\n",
    "        cb.add_request(p)\n",
    "    \n",
    "    print('Initial state:', cb.stats())\n",
    "    \n",
    "    # 模拟 5 步推理\n",
    "    for step in range(5):\n",
    "        cb.step()\n",
    "        print(f'Step {step+1}: {cb.stats()}')\n",
    "    \n",
    "    print(f'\\nTotal completed: {cb.stats()[\"completed\"]} / {len(prompts)}')\n",
    "\n",
    "asyncio.run(simulate_continuous_batching())"
   ]
