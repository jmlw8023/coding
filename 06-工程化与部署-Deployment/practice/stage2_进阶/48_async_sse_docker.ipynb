   "source": [
    "MODE = 'OFFLINE'\n",
    "\n",
    "import asyncio, json, time, hashlib, re, math, sys, inspect\n",
    "from dataclasses import dataclass, field\n",
    "from typing import AsyncIterator, Callable, Optional\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "\n",
    "# 模拟异步 LLM\n",
    "async def stub_async_chat(prompt: str, stream: bool = False) -> str:\n",
    "    if not stream:\n",
    "        return f'[STUB-LLM async] {prompt[:50]}...'\n",
    "    chunks = ['我是助手。', '基于', '上下文', '回答。']\n",
    "    for i, chunk in enumerate(chunks):\n",
    "        await asyncio.sleep(0.1)  # 模拟延迟\n",
    "        yield chunk\n",
    "\n",
    "async def chat_fn(prompt: str, stream: bool = False) -> str:\n",
    "    async def gen():\n",
    "        async for chunk in stub_async_chat(prompt, stream=True):\n",
    "            yield chunk\n",
    "    if stream:\n",
    "        return ''.join([c async for c in gen()])\n",
    "    else:\n",
    "        return await stub_async_chat(prompt, stream=False)\n",
    "\n",
    "# 模拟异步 embed\n",
    "async def fake_async_embed(text: str, dim: int = 128) -> list[float]:\n",
    "    seed = int(hashlib.sha256(text.encode('utf-8')).hexdigest()[:8], 16)\n",
    "    import random\n",
    "    random.seed(seed)\n",
    "    return [random.random() for _ in range(dim)]\n",
    "\n",
    "async def embed_fn(text: str, dim: int = 128) -> list[float]:\n",
    "    return await fake_async_embed(text, dim)\n",
    "\n",
    "print('✅ async 模块加载完毕；chat_fn / embed_fn 是纯函数接口，支持 async / sync 二态调用')"
   ]
  },
