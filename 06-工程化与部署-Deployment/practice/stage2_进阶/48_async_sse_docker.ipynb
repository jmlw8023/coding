    "## 3. RAGSystem 异步封装 —— async / await 流程\n",
    "\n",
    "**关键改动**：\n",
    "- `_retrieve` / `query` 改成 `async def`\n",
    "- embed / chat 改成 `async def`\n",
    "- 流式生成用 `async for chunk in chat_fn(..., stream=True)`\n",
    "- 返回 `AsyncIterator[str]`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s3-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "class AsyncRAGResult:\n",
    "    question: str\n",
       "contexts: list[str]\n",
    "    retrieved_ids: list[int]\n",
    "    latency_ms: float\n",
    "\n",
    "class AsyncRAGSystem:\n",
    "    def __init__(self, docs: list[str], embed_fn: Callable[[str], list[float]], chat_fn: Callable[[str], str], top_k: int = 3):\n",
    "        self.docs = docs\n",
    "        self.embed_fn = embed_fn\n",
    "        self.chat_fn = chat_fn\n",
    "        self.top_k = top_k\n",
    "        # 预计算向量\n",
    "        self.doc_vecs = asyncio.run(asyncio.gather(*[embed_fn(d) for d in docs]))\n",
    "\n",
    "    async def _retrieve(self, question: str, recall_k: int) -> list[int]:\n",
    "        q = await self.embed_fn(question)\n",
    "        sims = [sum(a * b for a, b in zip(q, v)) for v in self.doc_vecs]  # 简单的点积\n",
    "        return [int(i) for i in sorted(range(len(sims)), key=lambda x: -sims[x])[:recall_k]]\n",
    "\n",
    "    async def query(self, question: str) -> AsyncRAGResult:\n",
    "        t0 = time.perf_counter()\n",
    "        # 召回\n",
    "        recall_k = self.top_k * 3\n",
    "        candidate_ids = await self._retrieve(question, recall_k)\n",
    "        final_ids = candidate_ids[:self.top_k]\n",
    "        contexts = [self.docs[i] for i in final_ids]\n",
    "        # 生成（流式）\n",
    "        async for chunk in self.chat_fn('\\n'.join(f'[d{i}] {c}' for i, c in zip(final_ids, contexts)), stream=True):\n",
    "            pass  # 这里可以 yield chunk 给前端\n",
    "        return AsyncRAGResult(\n",
    "            question=question, contexts=contexts, retrieved_ids=final_ids,\n",
    "            latency_ms=(time.perf_counter() - t0) * 1000\n",
    "        )\n",
    "\n",
    "# 示例：异步 RAG 调用\n",
    "async def demo_async_rag():\n",
    "    docs = ['文档 A', '文档 B', '文档 C']\n",
    "    rag = AsyncRAGSystem(docs, embed_fn, chat_fn, top_k=3)\n",
    "    result = await rag.query('测试问题')\n",
    "    print(f'\\n--- AsyncRAGResult ---')\n",
    "    print(f'Question: {result.question}')\n",
    "    print(f'Contexts: {result.contexts}')\n",
    "    print(f'Retrieved IDs: {result.retrieved_ids}')\n",
    "    print(f'Latency: {result.latency_ms:.2f} ms')\n",
    "\n",
    "asyncio.run(demo_async_rag())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s3-c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 并发测试：同时问 5 个问题\n",
    "async def concurrent_queries():\n",
    "    docs = ['文档 A', '文档 B', '文档 C'] * 5  # 15 个文档\n",
    "    rag = AsyncRAGSystem(docs, embed_fn, chat_fn, top_k=3)\n",
    "    questions = ['什么是 RAG？', 'Transformer 怎么样？', 'embed 原理？'] * 5\n",
    "    tasks = [rag.query(q) for q in questions]\n",
    "    results = await asyncio.gather(*tasks)\n",
    "    \n",
    "    print(f'并发问了 {len(results)} 个问题')\n",
    "    print(f'平均延迟: {sum(r.latency_ms for r in results) / len(results):.2f} ms')\n",
    "    print(f'最快: {min(r.latency_ms for r in results):.2f} ms')\n",
    "    print(f'最慢: {max(r.latency_ms for r in results):.2f} ms')\n",
    "\n",
    "asyncio.run(concurrent_queries())"
   ]
  },
