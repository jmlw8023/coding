    "## 2. RAGAS 5 指标 —— 从 4 件套扩展到 5 件套\n",
    "\n",
    "**RAGAS（Retrieval Augmented Generation Assessment）** 是业界最常用的 RAG 评估框架。\n",
    "\n",
    "**5 个核心指标**：\n",
    "1. **Faithfulness**：答案是否忠于上下文（无幻觉）\n",
    "2. **Context Relevance**：召回的 context 与问题是否相关\n",
    "3. **Answer Relevance**：答案是否真正回答了问题\n",
    "4. **Context Precision**：top-k 里包含正确 doc 的比例\n",
    "5. **Answer Correctness**：答案与 gold standard 的语义匹配（可用 rouge/lm-judge）\n",
    "\n",
    "**分层评估策略**：\n",
    "- **Offline batch**：跑 eval set，算 baseline\n",
    "- **Online A/B test**：灰度发布两个版本，看哪个更好\n",
    "- **Real-time monitor**：在线上监控 drift（如用户反馈 / 流量分布变化）\n",
    "\n",
    "**RAGAS 的设计哲学**：\n",
    "- 每个指标都有 **answer level**（对每条 answer 评分）和 **segment level**（对每段 text 评分）\n",
    "- 支持分层采样（sample 100 题做 full eval，其他做 quick eval）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s2-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RAGAS 5 指标：重新实现 24 的 4 指标 + 1 新指标\n",
    "\n",
    "# 指标 1: Faithfulness（答案忠实度）—— 答案是否只依赖上下文\n",
    "def ragas_faithfulness(answer: str, contexts: list[str]) -> float:\n",
    "    \"\"\"RAGAS faithfulness：0-1，答案中的事实是否都能在 context 找到\"\"\"\n",
    "    if MODE == 'ONLINE':\n",
    "        ctx_text = '\\n'.join(contexts)\n",
    "        prompt = f\"{RUBRIC_FAITHFULNESS}\\n上下文:\\n{ctx_text}\\n回答:\\n{answer}\\n评分:\"\n",
    "        m = re.search(r'0\\.?\\d+', chat(prompt))\n",
    "        return float(m.group()) if m else 0.5\n",
    "    # OFFLINE：答案 token 在 context 中出现比例（粗略）\n",
    "    ctx_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', ' '.join(contexts).lower()))\n",
    "    answer_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', answer.lower()))\n",
    "    if not answer_tokens:\n",
    "        return 0.0\n",
    "    # 去除常见停用词\n",
    "    stop = set('的是有在了和与及对将让而为')\n",
    "    answer_tokens = answer_tokens - stop\n",
    "    if not answer_tokens:\n",
    "        return 1.0\n",
    "    return len(answer_tokens & ctx_tokens) / len(answer_tokens)\n",
    "\n",
    "# 指标 2: Context Relevance（上下文相关性）—— 召回的 context 和 query 多相关\n",
    "def ragas_context_relevance(question: str, contexts: list[str]) -> float:\n",
    "    \"\"\"RAGAS context_relevance：0-1，召回的 context 平均相关度\"\"\"\n",
    "    if MODE == 'ONLINE':\n",
    "        scores = []\n",
    "        for ctx in contexts:\n",
    "            prompt = f\"{RUBRIC_CONTEXT_RELEVANCE}\\n问题: {question}\\n文档: {ctx}\\n评分:\"\n",
    "            m = re.search(r'0\\.?\\d+', chat(prompt))\n",
    "            scores.append(float(m.group()) if m else 0.5)\n",
    "        return float(np.mean(scores))\n",
    "    # OFFLINE：token 重叠率\n",
    "    question_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', question.lower()))\n",
    "    if not question_tokens:\n",
    "        return 0.0\n",
    "    relevances = []\n",
    "    for ctx in contexts:\n",
    "        ctx_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', ctx.lower()))\n",
    "        relevances.append(len(question_tokens & ctx_tokens) / len(question_tokens))\n",
    "    return float(np.mean(relevances))\n",
    "\n",
    "# 指标 3: Answer Relevance（答案相关性）—— 答案是否回答了问题\n",
    "def ragas_answer_relevance(question: str, answer: str) -> float:\n",
    "    \"\"\"RAGAS answer_relevance：0-1，答案是否回答了问题\"\"\"\n",
    "    if MODE == 'ONLINE':\n",
    "        prompt = f\"{RUBRIC_ANSWER_RELEVANCE}\\n问题: {question}\\n回答: {answer}\\n评分:\"\n",
    "        m = re.search(r'0\\.?\\d+', chat(prompt))\n",
    "        return float(m.group()) if m else 0.5\n",
    "    # OFFLINE：答案是否包含问题关键词\n",
    "    q_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', question.lower()))\n",
    "    if not q_tokens:\n",
    "        return 0.0\n",
    "    a_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', answer.lower()))\n",
    "    hits = sum(1 for t in q_tokens if t in a_tokens)\n",
    "    return hits / len(q_tokens)\n",
    "\n",
    "# 指标 4: Context Precision（上下文精确度）—— top-k 包含正确 doc 的比例\n",
    "def ragas_context_precision(retrieved_ids: list[int], expected_ids: list[int]) -> float:\n",
    "    \"\"\"RAGAS context_precision：0-1，召回的 top-k 中有多少是正确的\"\"\"\n",
    "    if not retrieved_ids:\n",
    "        return 0.0\n",
    "    if not expected_ids:\n",
    "        return float('nan')\n",
    "    expected_set = set(expected_ids)\n",
    "    hits = sum(1 for r in retrieved_ids if r in expected_set)\n",
    "    return hits / len(retrieved_ids)\n",
    "\n",
    "# 指标 5: Answer Correctness（答案正确性）—— 答案与 gold 的语义匹配\n",
    "def ragas_answer_correctness(question: str, answer: str, gold_answer: str) -> float:\n",
    "    \"\"\"RAGAS answer_correctness：0-1，答案与 gold 的语义相似度\"\"\"\n",
    "    if MODE == 'ONLINE':\n",
    "        # 实际会用 rouge / semantic similarity，这里 stub\n",
    "        prompt = f\"评估回答与标准答案的语义相似度（0-1）:\\n问题: {question}\\n回答: {answer}\\n标准答案: {gold_answer}\\n评分:\"\n",
    "        m = re.search(r'0\\.?\\d+', chat(prompt))\n",
    "        return float(m.group()) if m else 0.5\n",
    "    # OFFLINE：简单关键词匹配（粗略）\n",
    "    gold_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', gold_answer.lower()))\n",
    "    if not gold_tokens:\n",
    "        return 0.0\n",
    "    a_tokens = set(re.findall(r'[^\\s\\n,。.?!;:，。？;：]', answer.lower()))\n",
    "    hits = sum(1 for t in gold_tokens if t in a_tokens)\n",
    "    return hits / len(gold_tokens)\n",
    "\n",
    "print('RAGAS 5 指标已实现（5/5）')"
   ]
  },
