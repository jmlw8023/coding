    "# OFFLINE：模拟评估指标\n",
    "\n",
    "def simulate_evaluation(baseline, improved):\n",
    "    \"\"\"模拟评估指标对比\"\"\"\n",
    "    print('=== KB-RAG 评估指标对比 ===')\n",
    "    \n",
    "    metrics = {\n",
    "        'Hit@5': (baseline['Hit@5'], improved['Hit@5']),\n",
    "        'EM': (baseline['EM'], improved['EM']),\n",
    "        'Faithfulness': (baseline['Faithfulness'], improved['Faithfulness']),\n",
    "        'Answer Relevance': (baseline['Answer Relevance'], improved['Answer Relevance']),\n",
    "        'p95 Latency': (baseline['p95 Latency'], improved['p95 Latency'])\n",
    "    }\n",
    "    \n",
    "    for metric, (old, new) in metrics.items():\n",
    "        gain = new - old\n",
    "        gain_pct = gain / old * 100 if old > 0 else 0\n",
    "        status = '✅' if gain > 0 else '❌'\n",
    "        print(f'  {status} {metric:15s}: {old:.2%} → {new:.2%} (+{gain_pct:.1f}%)')\n",
    "    \n",
    "    print(f'\\n平均提升: {(sum(new - old for old, new in metrics.values()) / len(metrics) * 100):.1f}%')\n",
    "\n",
    "baseline = {\n",
    "    'Hit@5': 0.52,\n",
    "    'EM': 0.35,\n",
    "    'Faithfulness': 0.70,\n",
    "    'Answer Relevance': 0.68,\n",
    "    'p95 Latency': 5.2  # 秒\n",
    "}\n",
    "\n",
    "improved = {\n",
    "    'Hit@5': 0.78,\n",
    "    'EM': 0.52,\n",
    "    'Faithfulness': 0.88,\n",
    "    'Answer Relevance': 0.85,\n",
    "    'p95 Latency': 2.8  # 秒\n",
    "}\n",
    "\n",
    "simulate_evaluation(baseline, improved)"
   ]
