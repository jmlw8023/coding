    "## 2. 工具集设计\n",
    "\n",
    "**工具列表**：\n",
    "1. **web_search**：Tavily / SerpAPI / 自建（需要 API key）\n",
    "2. **read_page**：Readability / trafilatura / BeautifulSoup\n",
    "3. **store_note**：笔记存储（ChromaDB / PostgreSQL）\n",
    "4. **search_memory**：向量库搜索（长期记忆）\n",
    "\n",
    "**工具设计原则**：\n",
    "- 单一职责：每个工具只做一件事\n",
    "- 失败恢复：web_search 失败则重试 3 次\n",
    "- 输出标准化：所有工具返回统一格式（dict）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s2-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# OFFLINE：模拟工具集\n",
    "\n",
    "class ToolRegistry:\n",
    "    def __init__(self):\n",
    "        self.tools = {}\n",
    "        self.register('web_search', self._web_search)\n",
    "        self.register('read_page', self._read_page)\n",
    "        self.register('store_note', self._store_note)\n",
    "        self.register('search_memory', self._search_memory)\n",
    "    \n",
    "    def register(self, name, func):\n",
    "        self.tools[name] = func\n",
    "    \n",
    "    def _web_search(self, query, max_results=3):\n",
    "        \"\"\"模拟 web 搜索（带重试）\"\"\"\n",
    "        for attempt in range(3):\n",
    "            try:\n",
    "                results = []\n",
    "                for i in range(max_results):\n",
    "                    results.append({\n",
    "                        'title': f'结果 {i+1}: {query[:30]}',\n",
    "                        'url': f'https://example.com/search/{i+1}',\n",
    "                        'snippet': f'这是关于 {query} 的搜索结果...'\n",
    "                    })\n",
    "                return results\n",
    "            except Exception as e:\n",
    "                print(f'  [重试 {attempt+1}/3] 失败: {e}')\n",
    "                time.sleep(1)\n",
    "        return []\n",
    "    \n",
    "    def _read_page(self, url, timeout=10):\n",
    "        \"\"\"模拟读取页面\"\"\"\n",
    "        return f'[页面内容] {url}: 这是一篇关于...的论文。摘要：...关键发现：...结论：...'\n",
    "    \n",
    "    def _store_note(self, content, tags, note_id=None):\n",
    "        \"\"\"存储笔记\"\"\"\n",
    "        if note_id is None:\n",
    "            note_id = int(hashlib.md5(content.encode()).hexdigest()[:8], 16)\n",
    "        return {'id': note_id, 'content': content[:200], 'tags': tags, 'stored': True}\n",
    "    \n",
    "    def _search_memory(self, query, top_k=5):\n",
    "        \"\"\"搜索长期记忆\"\"\"\n",
    "        # 模拟：返回前 top_k 条记忆\n",
    "        return [\n",
    "            {'id': i, 'content': f'这是关于 {query} 的笔记...', 'relevance': round(1 - i*0.1, 2)}\n",
    "            for i in range(top_k)\n",
    "        ]\n",
    "\n",
    "registry = ToolRegistry()\n",
    "print('=== ToolRegistry 已注册工具 ===')\n",
    "for name in registry.tools.keys():\n",
    "    print(f'  - {name}')\n",
    "\n",
    "print('\\n=== 测试 web_search（带重试）===')\n",
    "results = registry.tools['web_search']('RAG 评估最新进展')\n",
    "print(f'找到 {len(results)} 个结果')"
   ]
