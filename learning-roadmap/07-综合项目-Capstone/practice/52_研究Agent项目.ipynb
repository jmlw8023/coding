    "## 3. 失败恢复机制\n",
    "\n",
    **Checkpoint 设计**：\n",
    "- 记录每个子问题的状态（pending/processing/completed/failed）\n",
    "- 失败时从最近的 checkpoint 恢复\n",
    "- 重试策略：指数退避（1s, 2s, 4s）\n",
    "\n",
    **Observer 设计**：\n",
    "- 记录每个 step 的耗时、失败次数、成功次数\n",
    "- 最终生成轨迹评估报告\n",
    "- 评估成功率、平均耗时"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s3-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# OFFLINE：模拟 checkpoint + observer\n",
    "\n",
    "class CheckpointManager:\n",
    "    def __init__(self):\n",
    "        self.state = {}\n",
    "    \n",
    "    def checkpoint(self, sub_question):\n",
    "        \"\"\"创建 checkpoint\"\"\"\n",
    "        self.state[sub_question] = {\n",
    "            'status': 'pending',\n",
    "            'attempts': 0,\n",
    "            'start_time': time.time(),\n",
    "            'end_time': None\n",
    "        }\n",
    "        return sub_question\n",
    "    \n",
    "    def update_status(self, sub_question, status, duration=None):\n",
    "        \"\"\"更新状态\"\"\"\n",
    "        if sub_question in self.state:\n",
    "            self.state[sub_question]['status'] = status\n",
    "            if duration:\n",
    "                self.state[sub_question]['end_time'] = time.time()\n",
    "                self.state[sub_question]['duration'] = duration\n",
    "            self.state[sub_question]['attempts'] += 1\n",
    "\n",
    "class Observer:\n",
    "    def __init__(self):\n",
    "        self.traces = []\n",
    "    \n",
    "    def record_step(self, step_name, status, duration=None, error=None):\n",
    "        trace = {\n",
    "            'step': step_name,\n",
    "            'status': status,\n",
    "            'duration': duration,\n",
    "            'error': error\n",
    "        }\n",
    "        self.traces.append(trace)\n",
    "    \n",
    "    def generate_report(self):\n",
    "        \"\"\"生成轨迹评估报告\"\"\"\n",
    "        total_steps = len(self.traces)\n",
    "        success_steps = sum(1 for t in self.traces if t['status'] == 'success')\n",
    "        failed_steps = total_steps - success_steps\n",
    "        \n",
    "        avg_duration = sum(t['duration'] for t in self.traces if t['duration']) / total_steps\n",
    "        success_rate = success_steps / total_steps * 100\n",
    "        \n",
    "        print('=== Observer 轨迹评估报告 ===')\n",
    "        print(f'总步数: {total_steps}')\n",
    "        print(f'成功: {success_steps} ({success_rate:.1f}%)')\n",
    "        print(f'失败: {failed_steps}')\n",
    "        print(f'平均耗时: {avg_duration:.2f}s')\n",
    "        \n",
    "        print('\\n轨迹详情:')\n",
    "        for i, trace in enumerate(self.traces, 1):\n",
    "            status_icon = '✅' if trace['status'] == 'success' else '❌'\n",
    "            print(f'  [{i}] {status_icon} {trace[\"step\"]} ({trace[\"duration\"]:.2f}s)')\n",
    "        \n",
    "        return {'total': total_steps, 'success': success_steps, 'failed': failed_steps, 'success_rate': success_rate}\n",
    "\n",
    "# 模拟\n",
    "checkpoint = CheckpointManager()\n",
    "observer = Observer()\n",
    "\n",
    "print('=== Checkpoint + Observer 模拟 ===')\n",
    "# 模拟执行 3 个子问题\n",
    "for i in range(3):\n",
    "    question = f'子问题 {i+1}'\n",
    "    checkpoint.checkpoint(question)\n",
    "    observer.record_step(question, 'success', duration=2.5)\n",
    "\n",
    "# 模拟失败\n",
    "checkpoint.checkpoint('子问题 4')\n",
    "observer.record_step('子问题 4', 'failed', error='网络超时', duration=None)\n",
    "\n",
    "report = observer.generate_report()\n",
    "print(f'\\n成功率: {report[\"success_rate\"]:.1f}%')"
   ]
  },
