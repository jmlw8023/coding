    "## 4. 答案定位（答案末尾附 source）\n",
    "\n",
    **答案格式**：\n",
    "```\n",
    "根据第 15 页表 3，各部门销售额如下：\n",
    "- 销售：300 万元（同比 10%）\n",
    "- 市场：200 万元（同比 5%）\n",
    "\n",
    "**来源**：第 15 页表 3\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s4-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# OFFLINE：模拟答案定位\n",
    "\n",
    "def generate_answer(query, retrieved_docs):\n",
    "    \"\"\"生成答案 + 定位 source\"\"\"\n",
    "    sources = []\n",
    "    for doc in retrieved_docs:\n",
    "        if doc['type'] == 'table':\n",
    "            sources.append(f'第 {doc[\"page_num\"]} 页表 {doc[\"table_number\"]}')\n",
    "        elif doc['type'] == 'image':\n",
    "            sources.append(f'第 {doc[\"page_num\"]} 页图')\n",
    "        else:\n",
    "            sources.append(f'第 {doc[\"page_num\"]} 页')\n",
    "    \n",
    "    source_str = '，'.join(sources)\n",
    "    \n",
    "    answer = f\"基于检索到的内容，{query}。具体数据详见 {source_str}。\"\n",
    "    \n",
    "    return {\n",
    "        \"answer\": answer,\n",
    "        \"source\": source_str\n",
    "    }\n",
    "\n",
    "# 模拟检索结果\n",
    "retrieved = [\n",
    "    {\"type\": \"table\", \"page_num\": 15, \"table_number\": 3},\n",
    "    {\"type\": \"text\", \"page_num\": 10},\n",
    "    {\"type\": \"image\", \"page_num\": 10}\n",
    "]\n",
    "\n",
    "# 生成答案\n",
    "result = generate_answer(\"各部门业绩统计\", retrieved)\n",
    "\n",
    "print('=== 答案定位示例 ===')\n",
    "print(f'答案: {result[\"answer\"]}')\n",
    "print(f'\\n定位: {result[\"source\"]}')\n",
    "\n",
    "print('\\n=== 完整答案格式 ===')\n",
    "print('根据第 15 页表 3，各部门销售额如下：')\n",
    "print('- 销售：300 万元（同比 10%）')\n",
    "print('- 市场：200 万元（同比 5%）')\n",
    "print('\\n**来源**：第 15 页表 3')"
   ]
  },
  {
