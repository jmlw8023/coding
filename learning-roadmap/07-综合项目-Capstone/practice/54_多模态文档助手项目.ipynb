    "## 3. 多模态索引策略\n",
    "\n",
    **解析器选型**：\n",
    "- **PDF（正版）**：pypdfium2（快，支持中文）+ pypdf（fallback）\n",
    "- **PDF（扫描件）**：MinerU（混合 OCR）或 PaddleOCR（中文）\n",
    "- **DOCX**：python-docx\n",
    "- **PPT**：python-pptx\n",
    "\n",
    **多模态索引**：\n",
    "- **文字索引**：bge-m3（中文强）→ ChromaDB\n",
    "- **图像索引**：jina-CLIP（中文）→ ChromaDB\n",
    "- **表格索引**：Markdown → ChromaDB\n",
    "\n",
    **结构化表示**：\n",
    "```json\n",
    "{\n",
    "    \"doc_id\": 123,\n",
    "    \"page_num\": 15,\n",
    "    \"type\": \"table\",  // text / table / image\n",
    "    \"content\": \"第 15 页表 3：销售额统计\",\n",
    "    \"position\": {\"x\": 100, \"y\": 200},  // 位置（可选）\n",
    "    \"image_path\": \"/docs/doc123/page15_table3.png\",\n",
    "    \"vector_embedding\": [...],  // 文字 embedding\n",
    "    \"image_embedding\": [...]   // 图像 embedding\n",
    "}\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "s3-c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# OFFLINE：模拟多模态索引结构\n",
    "\n",
    "class MultiModalIndex:\n",
    "    def __init__(self):\n",
    "        self.text_index = []  # 文字索引\n",
    "        self.image_index = []  # 图像索引\n",
    "        self.table_index = []  # 表格索引\n",
    "    \n",
    "    def index_text(self, content, doc_id, page_num, position=None):\n",
    "        \"\"\"索引文字\"\"\"\n",
    "        item = {\n",
    "            \"type\": \"text\",\n",
    "            \"content\": content,\n",
    "            \"doc_id\": doc_id,\n",
    "            \"page_num\": page_num,\n",
    "            \"position\": position,\n",
    "            \"embedding\": np.random.randn(768)  # 模拟 bge-m3 embedding\n",
    "        }\n",
    "        self.text_index.append(item)\n",
    "        return item\n",
    "    \n",
    "    def index_image(self, image_path, doc_id, page_num, description):\n",
    "        \"\"\"索引图像\"\"\"\n",
    "        item = {\n",
    "            \"type\": \"image\",\n",
    "            \"image_path\": image_path,\n",
    "            \"doc_id\": doc_id,\n",
    "            \"page_num\": page_num,\n",
    "            \"description\": description,\n",
    "            \"embedding\": np.random.randn(512)  # 模拟 jina-CLIP embedding\n",
    "        }\n",
    "        self.image_index.append(item)\n",
    "        return item\n",
    "    \n",
    "    def index_table(self, markdown_content, doc_id, page_num, table_number):\n",
    "        \"\"\"索引表格\"\"\"\n",
    "        item = {\n",
    "            \"type\": \"table\",\n",
    "            \"content\": markdown_content,\n",
    "            \"doc_id\": doc_id,\n",
    "            \"page_num\": page_num,\n",
    "            \"table_number\": table_number,\n",
    "            \"embedding\": np.random.randn(768)  # 模拟 markdown embedding\n",
    "        }\n",
    "        self.table_index.append(item)\n",
    "        return item\n",
    "\n",
    "    def retrieve_mixed(self, query, top_k=3):\n",
    "        \"\"\"混合检索（RRF 融合）\"\"\"\n",
    "        # 简化：模拟混合检索\n",
    "        results = []\n",
    "        # 模拟文字检索\n",
    "        for item in self.text_index[:2]:\n",
    "            results.append({\"type\": \"text\", **item})\n",
    "        # 模拟图像检索\n",
    "        for item in self.image_index[:1]:\n",
    "            results.append({\"type\": \"image\", **item})\n",
    "        # 模拟表格检索\n",
    "        for item in self.table_index[:2]:\n",
    "            results.append({\"type\": \"table\", **item})\n",
    "        \n",
    "        return results[:top_k]\n",
    "\n",
    "print('=== 多模态索引（模拟）===')\n",
    "index = MultiModalIndex()\n",
    "\n",
    "# 索引文字\n",
    "index.index_text(\"第 10 页：年度销售额为 500 万元\", doc_id=1, page_num=10, position=(100, 200))\n",
    "index.index_text(\"第 15 页表 3：各部门业绩统计\", doc_id=1, page_num=15, position=(150, 250))\n",
    "\n",
    "# 索引图像\n",
    "index.index_image(\"/docs/doc1/page10_chart.png\", doc_id=1, page_num=10, description=\"柱状图：年度销售额变化\")\n",
    "\n",
    "# 索引表格\n",
    "index.index_table(\"| 部门 | 销售额 | 同比 |\\n|------|--------|------|\\n| 销售 | 300 | 10% |\\n| 市场 | 200 | 5% |\", doc_id=1, page_num=15, table_number=3)\n",
    "\n",
    "print(f'索引总数: {len(index.text_index)} 文字 + {len(index.image_index)} 图像 + {len(index.table_index)} 表格')\n",
    "\n",
    "# 混合检索\n",
    "print('\\n=== 混合检索（查询：各部门业绩）===')\n",
    "results = index.retrieve_mixed(\"各部门业绩\", top_k=3)\n",
    "for i, r in enumerate(results, 1):\n",
    "    print(f'  [{i}] {r["type"]:6s} doc{r["doc_id"]} p{r["page_num"]:2d} ({r.get(\"table_number\", \"-\") if r[\"type\"] == \"table\" else \"-\"})')\n",
    "\n",
    "print('\\n=== 多模态解析关键点 ===')\n",
    "print('  1. PDF 解析：扫描件用 PaddleOCR / MinerU')\n",
    "print('  2. 图表识别：识别类型 + 位置 + 数据提取（OCR）')\n",
    "print('  3. 表格解析：合并单元格 / 跨页表格')\n",
    "print('  4. 嵌入模型：中文用 jina-CLIP，英文用 CLIP')\n",
    "print('  5. 检索策略：文字 + 图 + 表 + RRF 融合')"
   ]
  },
