   "source": [
    "# OFFLINE 模式：模拟 judge 校准流程\n",
    "print('# ============ Judge 校准示例 ============\\n')\n",
    "\n",
    "# 模拟新采集的候选数据\n",
    "candidate_data = [\n",
    "    {'id': 201, 'question': '如何用 Chroma 构建向量数据库？', 'context': ['Chroma 是一个开源向量数据库...'], 'answer': '需要先安装 chromadb 库，然后用 chromadb.PersistentClient().get_collection() 创建 collection，再调用 embed_documents() 存储 documents，最后用 query() 检索。', 'gt': '需要先安装 chromadb 库，然后用 chromadb.PersistentClient().get_collection() 创建 collection，再调用 embed_documents() 存储 documents，最后用 query() 检索。'},\n",
    "    {'id': 202, 'question': 'RAG 在金融行业有什么应用？', 'context': ['RAG 在金融行业用于合规文档检索...'], 'answer': 'RAG 在金融行业用于合规文档检索、实时市场分析、投资报告生成。', 'gt': 'RAG 在金融行业用于合规文档检索、实时市场分析、投资报告生成、客户问答系统等，能大幅减少人工查询成本并提高准确率。'},\n",
    "    {'id': 203, 'question': 'LoRA 微调后怎么验证效果？', 'context': ['LoRA 是一种参数高效微调方法...'], 'answer': 'LoRA 微调后可以用 accuracy 指标验证效果。', 'gt': '验证效果的方法有：在验证集上跑评估指标（如 accuracy / bleu / rouge）、A/B 测试对比微调前后的回答质量、人工专家评估召回和生成的准确性。'},\n",
    "    {'id': 204, 'question': '向量检索为什么比关键词检索更灵活？', 'context': ['向量检索基于语义相似度...'], 'answer': '向量检索只能匹配精确词，关键词检索更灵活。', 'gt': '向量检索基于语义相似度，能理解同义词、近义词和上下文相关的内容，而关键词检索只能匹配精确词。例如"Apple"在水果和公司两种语境下，向量检索都能正确召回。'},\n",
    "    {'id': 205, 'question': '如何评估 RAG 系统的检索质量？', 'context': ['评估检索质量的主要指标有...'], 'answer': '评估检索质量的主要指标有 precision@3、recall@3。', 'gt': '评估检索质量的主要指标有：Recall@k（召回率）、Precision@k（精确率）、MRR（平均倒数排名）、NDCG（归一化折损累计增益）。可以通过人工标注 query → 知道应该召回哪些文档，再对比召回结果。'},\n",
    "]\n",
    "\n",
    "print(f'候选数据量: {len(candidate_data)} 条\\n')\n",
    "\n",
    "# Rule-based judge\n",
    "def rule_judge(item: dict) -> dict:\n",
    "    checks = {\n",
    "        'has_context': len(item['context']) > 0,\n",
    "        'answer_length': len(item['answer']) > 10,\n",
    "        'gt_exists': len(item['gt']) > 0,\n",
    "        'gt_match': item['answer'] == item['gt'],  # 简化：完全匹配\n",
    "    }\n",
    "    \n",
    "    # 综合判断\n",
    "    if checks['has_context'] and checks['answer_length'] and checks['gt_exists']:\n",
    "        if checks['gt_match']:\n",
    "            return {'status': 'both_pass', 'reason': '答案与 ground truth 完全一致'}\n",
    "        else:\n",
    "            return {'status': 'generation_pass', 'reason': '答案不完全匹配，但检索和生成都在工作'}\n",
    "    else:\n",
    "        return {'status': 'neither_pass', 'reason': '数据不完整或答案质量差'}\n",
    "\n",
    "# LLM judge（模拟：用字符串长度模拟「准确性」判断）\n",
    "def llm_judge_simulated(item: dict) -> dict:\n",
    "    # 模拟：检查答案长度和与 ground truth 的相似度\n",
    "    gt = item['gt']\n",
    "    ans = item['answer']\n",
    "    \n",
    "    # 简单检查：gt 中的关键短语是否在 answer 中出现\n",
    "    gt_keywords = [kw for kw in gt.split() if len(kw) > 2]\n",
    "    ans_has_keywords = any(kw in ans for kw in gt_keywords)\n",
    "    \n",
    "    if ans_has_keywords and len(ans) > 20:\n",
    "        return {'status': 'both_pass', 'reason': 'LLM judge: 答案包含关键信息且长度合理'}\n",
    "    elif ans_has_keywords:\n",
    "        return {'status': 'generation_pass', 'reason': 'LLM judge: 答案有部分正确信息'}\n",
    "    else:\n",
    "        return {'status': 'neither_pass', 'reason': 'LLM judge: 答案缺少关键信息'}\n",
    "\n",
    "# 校准流程\n",
    "passed_data = []\n",
    "failed_data = []\n",
    "\n",
    "for item in candidate_data:\n",
    "    rule_result = rule_judge(item)\n",
    "    llm_result = llm_judge_simulated(item)\n",
