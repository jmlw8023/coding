   "source": [
    "# OFFLINE 模式：用字典模拟飞轮流程\n",
    "print('# ============ 数据飞轮核心概念 ============\\n')\n",
    "\n",
    "# 环节 1: 数据采集（这里模拟新增的 5 条 query）\n",
