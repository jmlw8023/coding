    "baseline_results = {'accuracy': 0.92, 'recall@3': 0.85, 'precision@3': 0.78}\n",
    "new_results = {'accuracy': 0.94, 'recall@3': 0.87, 'precision@3': 0.80}\n",
    "\n",
    "print('基准评估结果:')\n",
    "for k, v in baseline_results.items():\n",
    "    print(f'  {k}: {v}')\n",
    "\n",
    "print('\\n新数据评估结果:')\n",
    "for k, v in new_results.items():\n",
    "    print(f'  {k}: {v}')\n",
    "\n",
    "# 环节 3: judge 校准（自动化判断是否通过）\n",
    "judge_thresholds = {'accuracy': 0.90, 'recall@3': 0.80, 'precision@3': 0.75}\n",
    "\n",
    "def judge_pass(results: dict, thresholds: dict) -> bool:\n",
    "    for k, v in results.items():\n",
    "        if v < thresholds.get(k, 0):\n",
    "            return False\n",
    "    return True\n",
    "\n",
