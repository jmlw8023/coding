    "# OFFLINE 模式：模拟 CI workflow\n",
    "print('# ============ CI 集成示例 ============\\n')\n",
    "\n",
    "# 模拟 PR 信息\n",
    "pr_info = {\n",
    "    'number': 123,\n",
    "    'title': '优化 RAG 检索算法，使用 HNSW 代替 brute-force',\n",
    "    'author': 'user1',\n",
    "    'status': 'open',\n",
    "}\n",
    "\n",
    "print(f'PR #{pr_info[\"number\"]}: {pr_info[\"title\"]} (by {pr_info[\"author\"]})\\n')\n",
    "\n",
    "# 模拟评估脚本执行结果\n",
    "evaluation_results = {\n",
    "    'recall@3': 0.89,\n",
    "    'precision@3': 0.82,\n",
    "    'accuracy': 0.93,\n",
    "    'avg_latency_ms': 45,\n",
    "}\n",
    "\n",
    "print('评估结果:')\n",
    "for k, v in evaluation_results.items():\n",
    "    print(f'  {k}: {v}')\n",
    "\n",
    "# 模拟阈值配置\n",
    "ci_thresholds = {\n",
    "    'recall@3': 0.85,\n",
    "    'precision@3': 0.80,\n",
    "    'accuracy': 0.90,\n",
    "    'max_latency_ms': 100,\n",
    "}\n",
    "\n",
    "# CI 判断逻辑\n",
    "def ci_check(results: dict, thresholds: dict) -> dict:\n",
    "    status = 'pass'\n",
    "    reasons = []\n",
    "    \n",
    "    for k, v in results.items():\n",
    "        if k == 'avg_latency_ms':\n",
    "            if v > thresholds[k]:\n",
    "                status = 'fail'\n",
    "                reasons.append(f'延迟超限: {v}ms > {thresholds[k]}ms')\n",
    "        else:\n",
    "            if v < thresholds[k]:\n",
    "                status = 'fail'\n",
    "                reasons.append(f'{k} 不达标: {v} < {thresholds[k]}')\n",
    "    \n",
    "    return {'status': status, 'reasons': reasons}\n",
    "\n",
    "ci_result = ci_check(evaluation_results, ci_thresholds)\n",
    "\n",
    "# CI 输出\n",
    "print(f'\\nCI 结果: {ci_result[\"status\"]}')\n",
    "if ci_result['reasons']:\n",
    "    print('  ❌ 不通过原因:')\n",
    "    for reason in ci_result['reasons']:\n",
    "        print(f'    - {reason}')\n",
    "\n",
    "# 决策：是否阻断合并\n",
    "if ci_result['status'] == 'fail':\n",
    "    print(f'\\n❌ 阻断合并 PR #{pr_info[\"number\"]}')\n",
    "    print('   建议：修复问题后重新提交 PR')\n",
    "else:\n",
    "    print(f'\\n✅ 允许合并 PR #{pr_info[\"number\"]}')\n",
    "    print('   注意：合并后仍建议在主分支上跑一次完整评估，确保全量数据都通过')"
   ]
