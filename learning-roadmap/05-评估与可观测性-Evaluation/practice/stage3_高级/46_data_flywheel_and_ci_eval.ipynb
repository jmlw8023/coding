   "source": [
    "# OFFLINE 模式：模拟数据清洗流程\n",
    "print('# ============ 数据清洗流程模拟 ============\\n')\n",
    "\n",
    "# 模拟原始数据\n",
    "raw_data = [\n",
    "    {'id': 401, 'question': '如何评估 RAG 系统的检索质量？', 'gt': 'Recall@k、Precision@k', 'priority': 'high'},\n",
    "    {'id': 402, 'question': 'Chroma 构建向量数据库', 'gt': '需要安装 chromadb 库', 'priority': 'medium'},\n",
    "    {'id': 403, 'question': '如何评估 RAG 系统的检索质量？', 'gt': 'Recall@k、Precision@k', 'priority': 'high'},  # 重复\n",
    "    {'id': 404, 'question': 'LoRA 微调后怎么验证效果？', 'gt': '在验证集上跑评估指标', 'priority': 'high'},\n",
    "    {'id': 405, 'question': '向量检索为什么更灵活', 'gt': '基于语义相似度', 'priority': 'medium'},\n",
    "    {'id': 406, 'question': 'RAG 在金融行业有什么应用？', 'gt': '合规文档检索、市场分析', 'priority': 'high'},\n",
    "    {'id': 407, 'question': '短答案', 'gt': '测试', 'priority': 'low'},  # 太短\n",
    "    {'id': 408, 'question': '测试query', 'gt': '', 'priority': 'medium'},  # 没有答案\n",
    "]\n",
    "\n",
    "print(f'原始数据量: {len(raw_data)} 条\\n')\n",
    "\n",
    "# 清洗步骤 1：去重\n",
    "print('步骤 1: 去重')\n",
    "def deduplicate(data: list) -> list:\n",
    "    seen = set()\n",
    "    unique = []\n",
    "    for item in data:\n",
    "        q = item['question']\n",
    "        if q not in seen:\n",
    "            seen.add(q)\n",
    "            unique.append(item)\n",
    "    return unique\n",
    "\n",
    "deduplicated = deduplicate(raw_data)\n",
    "print(f'   去重后: {len(deduplicated)} 条 (去重 {len(raw_data) - len(deduplicated)} 条)\\n')\n",
    "\n",
    "# 清洗步骤 2：过滤短答案\n",
    "print('步骤 2: 过滤短答案')\n",
    "def filter_short_answers(data: list, min_len: int = 10) -> list:\n",
    "    return [item for item in data if len(item['gt']) >= min_len]\n",
    "\n",
    "filtered = filter_short_answers(deduplicated, min_len=10)\n",
    "print(f'   过滤后: {len(filtered)} 条 (过滤 {len(deduplicated) - len(filtered)} 条)\\n')\n",
    "\n",
    "# 清洗步骤 3：过滤无效数据\n",
    "print('步骤 3: 过滤无效数据')\n",
    "def filter_invalid(data: list) -> list:\n",
    "    return [item for item in data if item['gt'].strip()]  # gt 不为空\n",
    "\n",
    "cleaned = filter_invalid(filtered)\n",
    "print(f'   清洗后: {len(cleaned)} 条 (过滤 {len(filtered) - len(cleaned)} 条)\\n')\n",
    "\n",
    "# 清洗步骤 4：优先级排序\n",
    "print('步骤 4: 优先级排序')\n",
    "priority_order = {'high': 0, 'medium': 1, 'low': 2}\n",
    "def sort_by_priority(data: list) -> list:\n",
    "    return sorted(data, key=lambda x: priority_order[x['priority']])\n",
    "\n",
    "sorted_data = sort_by_priority(cleaned)\n",
    "print('   排序后数据:')\n",
    "for item in sorted_data:\n",
    "    print(f'     ID {item[\"id\"]}: {item[\"question\"][:30]}... (优先级: {item[\"priority\"]})')\n",
    "\n",
    "# 清洗统计\n",
    "print(f'\\n清洗统计:')\n",
    "print(f'   原始数据: {len(raw_data)} 条')\n",
    "print(f'   最终数据: {len(sorted_data)} 条')\n",
    "print(f'   保留率: {len(sorted_data)/len(raw_data)*100:.1f}%')\n",
    "print(f'   丢弃原因: 重复 {len(raw_data) - len(deduplicated)} 条, 短答案 {len(deduplicated) - len(filtered)} 条, 无效 {len(filtered) - len(cleaned)} 条')"
   ]
  },
