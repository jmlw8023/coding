    "if len(cleaned_data) > MIN_SAMPLES:\n",
    "    update_model(model, cleaned_data)\n",
    "    update_evaluation_dataset(eval_dataset, cleaned_data)\n",
    "    \n",
    "    # 6. 重新评估（闭环验证）\n",
    "    new_results = evaluate_on_data(eval_system, eval_dataset)\n",
    "    print(f'更新后结果: {new_results}')\n",
    "```\n",
    "\n",
    "### 实际部署时注意\n",
    "\n",
